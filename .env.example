# Copy to .env and fill in. All of these are optional — the app boots
# and runs fully (stub generator, in-memory store) with none of them set.

# Google AI Studio API key. Unset: falls back to the deterministic stub
# generator (no network call). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stamped onto every generated question; scores are grouped by this so
# prompt changes show up as pass-rate deltas. Defaults to "stub-v1".
PROMPT_VERSION=

# Defaults assume `docker compose up -d mongo` / local Mongo on 27017.
# Unset: falls back to an in-memory store (data lost on restart).
MONGO_URL=
MONGO_DB=
